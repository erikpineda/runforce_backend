# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Base de datos MySQL (Cloud SQL en produccion)
DB_NAME=runforce
DB_USER=runforceuser
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT
JWT_ACCESS_MINUTES=20
JWT_REFRESH_DAYS=7

# En True fuerza redirect a HTTPS y cookies Secure (config/settings/production.py).
# Dejar en False hasta que Nginx tenga TLS real (Certbot necesita un dominio, no una IP).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Correo (envio de OTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RunForce <no-reply@runforce.app>

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Google Sign-In
GOOGLE_CLIENT_ID=

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# CORS (solo si hay un cliente web/WebView)
CORS_ALLOWED_ORIGINS=

# Calorias
CALORIAS_FACTOR_SIN_PESO=60.0
CALORIAS_FACTOR_CON_PESO=1.036
